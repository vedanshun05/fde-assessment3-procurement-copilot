# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Offline simulation works without a model key and makes zero LLM calls.
COPILOT_MODE=offline
# Gemini offers a free tier. Create a key in https://aistudio.google.com/api-keys
# Keep the Google project on the free tier; active quotas vary by account/model.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Minimum gap between Gemini API requests; adjust to your AI Studio quota.
GEMINI_MIN_INTERVAL_SECONDS=6

# Optional paid alternative: set LLM_PROVIDER=openai and configure these instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
